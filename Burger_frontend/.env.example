# Copy to .env.local to override. Both are optional.

# Burger Theory API (the Laravel app in ../backend). Sign-up and log-in talk to it.
# Defaults to http://localhost:8000/api/v1 when unset. The API's FRONTEND_URL must
# match this site's origin (http://localhost:5173 in development) for CORS.
VITE_API_URL=http://localhost:8000/api/v1

# While this is empty, checkout tells signed-in customers that online ordering isn't
# connected yet. See src/services/orders.ts for where the request goes.
VITE_ORDER_API_URL=
