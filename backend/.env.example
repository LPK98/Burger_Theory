APP_NAME="Burger Theory API"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=UTC

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# PostgreSQL. Tests use a separate database named <DB_DATABASE>_test (see phpunit.xml).
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=burger_theory
DB_USERNAME=postgres
# Wrap the value in single quotes if it contains #, $ or spaces, e.g. DB_PASSWORD='p#ss word'
DB_PASSWORD=

SESSION_DRIVER=array
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Notifications are queued. Run `php artisan queue:work` alongside the API.
QUEUE_CONNECTION=database

CACHE_STORE=database

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="orders@burgertheory.example"
MAIL_FROM_NAME="Burger Theory"

# The React storefront. Used for CORS and the PayHere/Stripe return and cancel pages.
FRONTEND_URL=http://localhost:5173
# Optional: extra comma-separated browser origins allowed to call the API.
# CORS_ALLOWED_ORIGINS=http://localhost:5173,https://burgertheory.lk

# Sanctum personal access tokens expire after this many minutes (blank = never).
SANCTUM_TOKEN_EXPIRATION=10080

# Restaurant
RESTAURANT_NAME="Burger Theory"
RESTAURANT_TIMEZONE=Asia/Colombo
RESTAURANT_ADDRESS_LINE1="Burger Theory"
RESTAURANT_CITY=Colombo
ORDER_UNPAID_EXPIRY_MINUTES=60
# Optional extra inbox that receives new-order alerts.
ORDER_ALERT_EMAIL=

# PayHere — sandbox credentials from https://sandbox.payhere.lk (Integrations → domain/app).
# Never put the merchant secret in the frontend.
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_SANDBOX=true
# Defaults: FRONTEND_URL/checkout/complete and FRONTEND_URL/checkout/cancelled
PAYHERE_RETURN_URL=
PAYHERE_CANCEL_URL=
# Must be publicly reachable. Blank = APP_URL/api/v1/payments/payhere/notify.
# In development expose the API with a tunnel (e.g. `herd share` or ngrok) and put that URL here.
PAYHERE_NOTIFY_URL=

# Stripe — Checkout (hosted payment page). Keys from https://dashboard.stripe.com/test/apikeys
# (sk_test_… while testing; nothing real is charged). Server-side only: never put these in VITE_*.
STRIPE_SECRET_KEY=
# Webhook signing secret (whsec_…). Locally: `stripe listen --forward-to localhost:8000/api/v1/payments/stripe/webhook`
# prints one. In production: Dashboard → Developers → Webhooks → your endpoint → Signing secret.
STRIPE_WEBHOOK_SECRET=
# Defaults: FRONTEND_URL/?checkout=complete and FRONTEND_URL/?checkout=cancelled
STRIPE_SUCCESS_URL=
STRIPE_CANCEL_URL=
# How long the payment page stays open (30–1440 minutes).
STRIPE_SESSION_MINUTES=30

# Cloudinary — product image uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=burger-theory/products

# Used only by `php artisan db:seed` to create the first administrator (optional;
# `php artisan app:create-admin` does the same interactively). Development only: use a
# throwaway password, never a real one, and leave both blank in production.
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
