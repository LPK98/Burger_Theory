<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="vendor/autoload.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <env name="APP_ENV" value="testing"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file"/>
        <env name="BCRYPT_ROUNDS" value="4"/>
        <env name="BROADCAST_CONNECTION" value="null"/>
        <env name="CACHE_STORE" value="array"/>
        <!-- Tests run against PostgreSQL, in a dedicated database that RefreshDatabase rebuilds.
             Host, port, user and password come from .env. tests/TestCase.php refuses to run
             against any database whose name does not end in _test. -->
        <env name="DB_CONNECTION" value="pgsql"/>
        <env name="DB_DATABASE" value="burger_theory_test"/>
        <env name="DB_URL" value=""/>
        <env name="MAIL_MAILER" value="array"/>
        <env name="QUEUE_CONNECTION" value="sync"/>
        <env name="SESSION_DRIVER" value="array"/>
        <env name="PULSE_ENABLED" value="false"/>
        <env name="TELESCOPE_ENABLED" value="false"/>
        <env name="NIGHTWATCH_ENABLED" value="false"/>
        <env name="FRONTEND_URL" value="http://localhost:5173"/>
        <!-- Fake credentials for signature tests only; no request ever reaches PayHere. -->
        <env name="PAYHERE_MERCHANT_ID" value="1211149"/>
        <env name="PAYHERE_MERCHANT_SECRET" value="test-merchant-secret"/>
        <env name="PAYHERE_SANDBOX" value="true"/>
        <env name="PAYHERE_NOTIFY_URL" value=""/>
        <env name="PAYHERE_RETURN_URL" value=""/>
        <env name="PAYHERE_CANCEL_URL" value=""/>
        <env name="CLOUDINARY_CLOUD_NAME" value=""/>
        <env name="CLOUDINARY_API_KEY" value=""/>
        <env name="CLOUDINARY_API_SECRET" value=""/>
        <env name="ORDER_ALERT_EMAIL" value=""/>
        <env name="SANCTUM_TOKEN_EXPIRATION" value=""/>
    </php>
</phpunit>
